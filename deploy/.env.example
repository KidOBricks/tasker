# Tasker PocketBase Server Environment Configuration
# Copy to /opt/tasker/.env (oci-setup.sh generates this automatically)

TASKER_DOMAIN=127-0-0-1.sslip.io
TASKER_PUBLIC_URL=https://127-0-0-1.sslip.io

# 64-char hex (32 bytes) AES-256-GCM key for encrypting OAuth refresh tokens
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth 2.0 (Calendar + Gmail + SSO)
# Redirect URIs:
#   https://<domain>/api/integrations/google/callback
#   https://<domain>/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID OAuth 2.0 (Outlook Calendar + SSO)
# Redirect URIs:
#   https://<domain>/api/integrations/microsoft/callback
#   https://<domain>/api/oauth2-redirect
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Server-side AI Email Extractor (pluggable)
# LLM_PROVIDER: gemini | groq | openrouter | openai_compat | heuristic
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides for openai_compat / custom models:
LLM_BASE_URL=
LLM_MODEL=
